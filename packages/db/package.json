{
  "name": "@dcc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./events": "./src/events/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "guards": "node src/apply-guards.ts",
    "studio": "drizzle-kit studio",
    "dev:reset": "node -e \"require('node:fs').rmSync('.pgdata',{recursive:true,force:true})\"",
    "dev:setup": "node src/dev/setup.ts",
    "dev:prove": "node src/dev/prove.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.1"
  }
}
