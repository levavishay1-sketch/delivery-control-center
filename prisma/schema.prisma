// Delivery Control Center — data model
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IntegrationType {
  MANUAL
  JIRA
  AZURE_DEVOPS
}

enum StageType {
  CONSTITUTION
  SPEC
  PLAN
  TASKS
  DEPLOY
}

enum StageStatus {
  PENDING
  AI_DRAFTING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DONE
}

enum PipelineStatus {
  ACTIVE
  COMPLETED
  BLOCKED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum AuditActor {
  SYSTEM
  AI
  USER
}

// Auth.js-shaped tables. Only Credentials + JWT sessions are wired up in
// src/auth.ts for now (see design.md — the Prisma adapter isn't configured
// yet because nothing exercises it: Credentials + JWT doesn't call adapter
// methods, and wiring it prematurely risks a type mismatch between our
// custom-output PrismaClient and the adapter's @prisma/client-typed
// signature for zero functional benefit). Account/Session/VerificationToken
// exist now so adding a real OAuth provider later is additive, not a
// migration.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  isOrgAdmin    Boolean   @default(false)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships ClientMembership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  MANAGER
  PROJECT_MANAGER
  TECH_LEAD
  EXECUTOR
  VIEWER
  SECURITY_REVIEWER
}

model ClientMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
}

model Client {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  integrationConfig Json?
  aiConfig         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  projects    Project[]
  memberships ClientMembership[]

  @@unique([organizationId, slug])
}

model Project {
  id                String          @id @default(cuid())
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  key               String
  integrationType   IntegrationType @default(MANUAL)
  integrationConfig Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workItems   WorkItem[]
  auditEvents AuditEvent[]

  @@unique([clientId, key])
}

model WorkItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      IntegrationType
  externalId  String
  externalUrl String?
  title       String
  description String?
  status      String   @default("open")
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  pipeline Pipeline?

  @@unique([projectId, source, externalId])
}

model Pipeline {
  id            String         @id @default(cuid())
  workItemId    String         @unique
  workItem      WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  currentStage  StageType      @default(CONSTITUTION)
  status        PipelineStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stages      Stage[]
  auditEvents AuditEvent[]
}

model Stage {
  id               String      @id @default(cuid())
  pipelineId       String
  pipeline         Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  type             StageType
  status           StageStatus @default(PENDING)
  content          String?
  aiModel          String?
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal?    @db.Decimal(10, 4)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  approvals   Approval[]
  auditEvents AuditEvent[]

  @@unique([pipelineId, type])
}

model Approval {
  id           String            @id @default(cuid())
  stageId      String
  stage        Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  decision     ApprovalDecision
  approverName String
  comment      String?
  decidedAt    DateTime          @default(now())
}

// pipelineId/projectId are both optional because an event can originate above
// pipeline scope (e.g. a project-level integration sync) — but every audit
// event still records enough to trace back to what it's about.
model AuditEvent {
  id         String      @id @default(cuid())
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipelineId String?
  pipeline   Pipeline?   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String?
  stage      Stage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  actor      AuditActor
  actorName  String?
  action     String
  detail     Json?
  createdAt  DateTime    @default(now())

  @@index([pipelineId, createdAt])
  @@index([projectId, createdAt])
}
