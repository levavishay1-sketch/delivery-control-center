// Delivery Control Center — data model
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IntegrationType {
  MANUAL
  JIRA
  AZURE_DEVOPS
}

enum StageType {
  CONSTITUTION
  SPEC
  PLAN
  TASKS
  DEPLOY
}

enum StageStatus {
  PENDING
  AI_DRAFTING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DONE
}

enum PipelineStatus {
  ACTIVE
  COMPLETED
  BLOCKED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum AuditActor {
  SYSTEM
  AI
  USER
}

enum WorkItemType {
  PROJECT
  TASK
  BUG
  CHANGE
}

enum WorkStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  DECISION_REQUIRED
  BLOCKED
  REVIEW
  APPROVED
  COMPLETED
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutorType {
  HUMAN
  AI_AGENT
  HYBRID
  UNASSIGNED
}

enum DecisionStatus {
  OPEN
  APPROVED
  REJECTED
}

// Auth.js-shaped tables. Only Credentials + JWT sessions are wired up in
// src/auth.ts for now (see design.md — the Prisma adapter isn't configured
// yet because nothing exercises it: Credentials + JWT doesn't call adapter
// methods, and wiring it prematurely risks a type mismatch between our
// custom-output PrismaClient and the adapter's @prisma/client-typed
// signature for zero functional benefit). Account/Session/VerificationToken
// exist now so adding a real OAuth provider later is additive, not a
// migration.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  isOrgAdmin    Boolean   @default(false)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships ClientMembership[]
  approvals   Approval[]
  auditEvents AuditEvent[]

  ownedWorkItems    WorkItem[] @relation("WorkItemOwner")
  executedWorkItems WorkItem[] @relation("WorkItemExecutor")
  ownedBlockers     Blocker[]  @relation("BlockerOwner")
  decidedDecisions  Decision[] @relation("DecisionApprover")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  MANAGER
  PROJECT_MANAGER
  TECH_LEAD
  EXECUTOR
  VIEWER
  SECURITY_REVIEWER
}

model ClientMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
}

model Client {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  integrationConfig Json?
  aiConfig         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  projects    Project[]
  memberships ClientMembership[]

  @@unique([organizationId, slug])
}

model Project {
  id                String          @id @default(cuid())
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  key               String
  integrationType   IntegrationType @default(MANUAL)
  integrationConfig Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workItems   WorkItem[]
  auditEvents AuditEvent[]

  @@unique([clientId, key])
}

model WorkItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      IntegrationType
  externalId  String
  externalUrl String?
  title       String
  description String?
  status      WorkStatus @default(OPEN)
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  // Slice 1 — delivery model extension. `source` (above) already serves the
  // role a separate "sourceMode" field would have; not duplicated.
  type         WorkItemType  @default(TASK)
  parentId     String?
  parent       WorkItem?     @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     WorkItem[]    @relation("WorkItemHierarchy")
  risk         RiskLevel     @default(MEDIUM)
  priority     PriorityLevel @default(MEDIUM)
  ownerId      String?
  owner        User?         @relation("WorkItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  executorType ExecutorType  @default(UNASSIGNED)
  executorId   String?
  executor     User?         @relation("WorkItemExecutor", fields: [executorId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  progress     Int           @default(0)
  aiCost       Decimal       @default(0) @db.Decimal(10, 4)

  pipeline     Pipeline?
  blockers     Blocker[]
  decisions    Decision[]
  dependsOn    Dependency[]  @relation("DependentWorkItem")
  dependedOnBy Dependency[]  @relation("DependencyTarget")
  auditEvents  AuditEvent[]

  @@unique([projectId, source, externalId])
  @@index([projectId, status])
  @@index([parentId])
}

model Dependency {
  id                  String   @id @default(cuid())
  workItemId          String
  workItem            WorkItem @relation("DependentWorkItem", fields: [workItemId], references: [id], onDelete: Cascade)
  dependsOnWorkItemId String
  dependsOnWorkItem   WorkItem @relation("DependencyTarget", fields: [dependsOnWorkItemId], references: [id], onDelete: Cascade)
  reason              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([workItemId, dependsOnWorkItemId])
}

model Blocker {
  id             String    @id @default(cuid())
  blockingItemId String
  blockingItem   WorkItem  @relation(fields: [blockingItemId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User      @relation("BlockerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reason         String
  requiredAction String
  blockedSince   DateTime  @default(now())
  impact         String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([blockingItemId, resolvedAt])
}

model Decision {
  id               String         @id @default(cuid())
  workItemId       String
  workItem         WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  question         String
  reason           String
  impact           String
  aiRecommendation String?
  aiConfidence     Decimal?       @db.Decimal(5, 2)
  deadline         DateTime?
  approverId       String?
  approver         User?          @relation("DecisionApprover", fields: [approverId], references: [id], onDelete: SetNull)
  status           DecisionStatus @default(OPEN)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resolvedAt       DateTime?

  @@index([workItemId, status])
}

model Pipeline {
  id            String         @id @default(cuid())
  workItemId    String         @unique
  workItem      WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  currentStage  StageType      @default(CONSTITUTION)
  status        PipelineStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stages      Stage[]
  auditEvents AuditEvent[]
}

model Stage {
  id               String      @id @default(cuid())
  pipelineId       String
  pipeline         Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  type             StageType
  status           StageStatus @default(PENDING)
  content          String?
  aiModel          String?
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal?    @db.Decimal(10, 4)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  approvals   Approval[]
  auditEvents AuditEvent[]

  @@unique([pipelineId, type])
}

model Approval {
  id           String            @id @default(cuid())
  stageId      String
  stage        Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  decision     ApprovalDecision
  // approverId is the real, session-derived identity; approverName is an immutable display
  // snapshot (kept even if the user is later renamed/removed) — not a half-measure, both are
  // meant to coexist. approverId is nullable only because it postdates this table.
  approverId   String?
  approver     User?             @relation(fields: [approverId], references: [id], onDelete: SetNull)
  approverName String
  comment      String?
  decidedAt    DateTime          @default(now())
}

// pipelineId/projectId are both optional because an event can originate above
// pipeline scope (e.g. a project-level integration sync) — but every audit
// event still records enough to trace back to what it's about.
model AuditEvent {
  id         String      @id @default(cuid())
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipelineId String?
  pipeline   Pipeline?   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String?
  stage      Stage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  // Slice 1: lets Blocker/Decision/Dependency events (which have no pipelineId)
  // trace back to the work item they're about, and powers the 360° Record's
  // per-item Timeline tab.
  workItemId String?
  workItem   WorkItem?   @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  actor      AuditActor
  // userId is the real, session-derived identity for USER-actor events; actorName is an
  // immutable display snapshot (also used for SYSTEM/AI actor names, which have no User row).
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorName  String?
  action     String
  detail     Json?
  createdAt  DateTime    @default(now())

  @@index([pipelineId, createdAt])
  @@index([projectId, createdAt])
  @@index([workItemId, createdAt])
}
