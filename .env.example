# --- Database ---
# Local docker-compose default, or a Neon/Supabase pooled connection string.
DATABASE_URL=postgres://dcc:dcc@localhost:5432/dcc

# The role the app connects as MUST be a non-superuser and MUST NOT have BYPASSRLS.
# guards.sql creates `dcc_app` for this. Superusers ignore RLS — never run the app as one.
DATABASE_APP_ROLE=dcc_app

# --- Azure DevOps (wired in a later Phase-0 slice; unset is fine for now) ---
ADO_ORG_URL=
ADO_PAT=

# --- Model routing (Phase 1+) ---
ANTHROPIC_API_KEY=
