# Postgres connection string. Free option: create a project at https://neon.tech,
# then copy the "Connection string" it gives you (includes ?sslmode=require).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: only needed if you want the Jira integration to actually sync work items.
# Leave unset to use the built-in manual work-item adapter instead.
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY=""

# Optional: only needed for real AI-drafted stages. Leave unset to use the
# built-in mock executor (fills prompt templates without calling a model).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Required. Signs session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Required. AES-256 key (base64, 32 bytes decoded) for encrypting integration
# credentials (e.g. Jira API tokens) at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Password for the org-admin user the seed script creates (admin@example.com).
SEED_ADMIN_PASSWORD="change-me-now"
