node_modules/
dist/
build/
*.tsbuildinfo
.env
.env.local
*.local
coverage/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
npm-debug.log*

# stray tsc output at package roots
OldServer/packages/*/*.js
OldServer/packages/*/*.d.ts
OldServer/packages/*/*.d.ts.map
OldServer/packages/*/*.js.map
!OldServer/packages/*/drizzle.config.ts
# ...and inside src/ — a package's sources are .ts; a compiled .js/.d.ts
# next to one is stale build output (28 of them were once committed by
# mistake). apps/*/src/vite-env.d.ts is a real source file, so apps are
# not covered by this rule.
OldServer/packages/*/src/**/*.js
OldServer/packages/*/src/**/*.js.map
OldServer/packages/*/src/**/*.d.ts
OldServer/packages/*/src/**/*.d.ts.map

# embedded dev database (PGlite)
OldServer/packages/*/.pgdata*
scratchpad/

# .NET server (Server/)
bin/
obj/
.vs/
*.user
TestResults/
# local-only secrets: signing key, initial admin password
Server/.local/
