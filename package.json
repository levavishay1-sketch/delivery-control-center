{
  "name": "delivery-control-center",
  "version": "0.0.0",
  "private": true,
  "description": "מערכת שעוטפת את מחזור החיים של פיתוח תוכנה מונחה-AI מקצה לקצה, סביב Azure DevOps ו-Claude Code.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:generate": "npm -w @dcc/db run generate",
    "db:migrate": "npm -w @dcc/db run migrate",
    "db:guards": "npm -w @dcc/db run guards",
    "typecheck": "tsc -b",
    "audit:stale": "node scripts/audit-stale.mjs",
    "sync": "node scripts/sync.mjs",
    "spec": "openspec",
    "info:drift": "node scripts/info-drift.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.23.13"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
