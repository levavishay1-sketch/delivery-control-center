{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The connection string is NOT here: `dotnet run -- db-bootstrap` writes it to
  // Server/.local/appsettings.local.json (outside git), which is loaded on top.
  "ConnectionStrings": {
    "Dcc": null
  },

  "Database": {
    "MigrateOnStartup": true
  },

  // The routing policy (config-as-code) and the "i" glossary, relative to this project.
  "ModelPolicy": {
    "Path": "../../../config/model-policy.json"
  },
  "Glossary": {
    "Path": "../../glossary"
  },

  "Auth": {
    "Issuer": "dcc",
    "Audience": "dcc-web",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "SigningKeyPath": "../../.local/jwt-signing.pem",
    "MinRsaKeyBits": 4096,
    "RefreshCookiePath": "/api/auth",
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 12,
    "WebSocket": {
      "AuthTimeoutSeconds": 5,
      "ReauthGraceSeconds": 30,
      "CheckIntervalSeconds": 15,
      "MaxMessageBytes": 65536,
      "MaxConnectionsPerUser": 10
    }
  },

  "Bootstrap": {
    "InitialAdminEmail": "admin@dcc.local",
    "InitialAdminName": "Administrator",
    "InitialAdminPasswordFile": "../../.local/initial-admin.txt"
  },

  // Independent AI agents change architecture decision 02 — off until the
  // amendment in docs/architecture-review.md is approved.
  "Agents": {
    "AllowIndependent": false
  },

  // Fill in once the application is registered in Entra ID. While empty, Entra
  // sign-in, guest invitations and the directory sync are all off.
  "Entra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/auth/entra/callback",
    "PostLoginRedirect": "/#/auth/complete",
    "GuestRedirectUrl": "",
    "DirectorySyncMinutes": 30
  }
}
