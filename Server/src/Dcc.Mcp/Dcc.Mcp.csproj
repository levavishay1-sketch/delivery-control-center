<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DCC's MCP server: a console process an MCP client (Claude Code) launches over stdio.
    It holds no database connection — every tool calls the REST API with the API token
    of a named person, so the permissions and the wall between clients apply as they
    do to any other request.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

</Project>
